# ==============================================================================
# FinPulse - Local Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi `.env` di direktori root proyek lalu isi nilainya
# sebelum menjalankan layanan backend Spring Boot & Docker Compose secara lokal.
#
# PENTING:
# - JANGAN pernah commit file `.env` yang berisi kredensial asli ke Git.
# - Nilai di bawah ini hanyalah placeholder contoh dan konfigurasi default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Backend (Spring Boot 3)
# ------------------------------------------------------------------------------
# Port HTTP untuk REST API & Swagger UI (default: 8080)
SERVER_PORT=8080

# Daftar origin frontend yang diizinkan CORS (pisahkan dengan koma jika > 1)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database (Wajib untuk Sprint 1, Sprint 2, Sprint 3 & Flyway)
# ------------------------------------------------------------------------------
# JDBC URL PostgreSQL Supabase (Project Settings -> Database -> Connection string).
# Format wajib: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Username database PostgreSQL Supabase (contoh: postgres)
SUPABASE_DB_USER=postgres

# Password database PostgreSQL Supabase (placeholder — isi dengan password DB asli Anda)
SUPABASE_DB_PASSWORD=replace-with-your-supabase-db-password

# ------------------------------------------------------------------------------
# 3. Supabase Storage & API (Sprint 2: Bukti Struk & Sprint 3: Ekspor Laporan)
# ------------------------------------------------------------------------------
# Base URL proyek Supabase Anda (Project Settings -> API -> Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service Role Key Supabase untuk upload file struk & laporan dari backend (placeholder).
# JANGAN gunakan key ini di frontend; hanya untuk server backend Spring Boot.
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key

# Nama bucket Supabase Storage untuk menyimpan foto struk transaksi (default: receipts).
# Validasi backend: hanya JPEG, PNG, atau WebP dengan ukuran maksimal 5 MB.
#
# Cara membuat bucket publik `receipts` di Supabase Dashboard (wajib sebelum upload struk):
# 1. Buka Supabase Dashboard proyek Anda -> menu Storage -> klik "New bucket".
# 2. Isi Name: `receipts` (atau samakan dengan nilai SUPABASE_STORAGE_BUCKET di bawah).
# 3. Aktifkan toggle "Public bucket" agar URL publik (`/storage/v1/object/public/receipts/...`)
#    dapat dirender pada preview foto struk di halaman Transaksi FinPulse.
# 4. (Opsional) Atur Allowed MIME types: image/jpeg, image/png, image/webp & File size limit: 5 MB.
# 5. Klik "Create bucket". Backend akan mengunggah file via SUPABASE_SERVICE_KEY ke path `<userId>/<uuid>.<ext>`.
SUPABASE_STORAGE_BUCKET=receipts

# Nama bucket Supabase Storage untuk menyimpan file ekspor laporan bulanan PDF/CSV (default: reports).
#
# Cara membuat bucket publik `reports` di Supabase Dashboard (wajib sebelum ekspor PDF/CSV):
# 1. Buka Supabase Dashboard proyek Anda -> menu Storage -> klik "New bucket".
# 2. Isi Name: `reports` (atau samakan dengan nilai SUPABASE_REPORTS_BUCKET di bawah).
# 3. Aktifkan toggle "Public bucket" agar URL publik (`/storage/v1/object/public/reports/...`)
#    dapat langsung diunduh dari halaman Ekspor Laporan (`/reports`) FinPulse.
# 4. (Opsional) Atur Allowed MIME types: application/pdf, text/csv.
# 5. Klik "Create bucket". Backend worker akan mengunggah file via SUPABASE_SERVICE_KEY ke path `<userId>/reports/<fileName>`.
SUPABASE_REPORTS_BUCKET=reports

# ------------------------------------------------------------------------------
# 4. Keamanan & JWT Authentication (Wajib untuk Sprint 1)
# ------------------------------------------------------------------------------
# Kunci rahasia HMAC-SHA256 untuk menandatangani JWT Access Token.
# Minimal 32 karakter (32 byte UTF-8 / setara kunci acak Base64 256-bit).
# Contoh membuat kunci aman di terminal: openssl rand -base64 32
JWT_SECRET=replace-with-random-secret-key-minimum-32-characters-or-base64-256bit

# Masa berlaku JWT Access Token dalam milidetik (default: 900000 = 15 menit)
JWT_ACCESS_EXPIRATION_MS=900000

# Masa berlaku Refresh Token dalam milidetik (default: 604800000 = 7 hari)
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 5. Cache Redis (Sprint 3 - Caching Ringkasan Dashboard)
# ------------------------------------------------------------------------------
# Tipe cache Spring Boot (default: redis; gunakan simple jika menjalankan tanpa Redis)
SPRING_CACHE_TYPE=redis

# Host & port server Redis lokal (dijalankan via docker-compose.yml di root)
REDIS_HOST=localhost
REDIS_PORT=6379

# Password Redis (kosongkan untuk konfigurasi default lokal Docker Compose)
REDIS_PASSWORD=

# Time-to-live (TTL) cache ringkasan dashboard dalam detik (default: 300 = 5 menit)
FINPULSE_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 6. Message Broker RabbitMQ (Sprint 3 - Over-Budget Alert & Ekspor Laporan)
# ------------------------------------------------------------------------------
# Host, port AMQP, dan port Management UI RabbitMQ (dijalankan via docker-compose.yml di root)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Kredensial default lokal RabbitMQ (dipakai oleh docker-compose.yml dan backend Spring Boot)
# Ganti nilai ini jika menggunakan instance RabbitMQ non-lokal / production.
RABBITMQ_USERNAME=finpulse
RABBITMQ_PASSWORD=finpulse_dev

# Aktifkan listener consumer RabbitMQ saat startup backend (default: true)
RABBITMQ_LISTENER_AUTO_STARTUP=true
