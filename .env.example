# --- Server & CORS ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Supabase PostgreSQL ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-db-password

# --- Supabase Storage ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=receipts
SUPABASE_REPORTS_BUCKET=reports

# --- JWT Authentication ---
JWT_SECRET=replace-with-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Redis Cache ---
SPRING_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
FINPULSE_CACHE_TTL_SECONDS=300

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=finpulse
RABBITMQ_PASSWORD=finpulse_dev
RABBITMQ_LISTENER_AUTO_STARTUP=true
